{
  "name": "wacha",
  "version": "1.0.0",
  "description": "Worker Aggregation and Control Hub for Agents",
  "homepage": "https://github.com/akihiroxob/wacha#readme",
  "bugs": {
    "url": "https://github.com/akihiroxob/wacha/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akihiroxob/wacha.git"
  },
  "license": "MIT",
  "author": "",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "tsx src/server.ts",
    "prestart": "npm run build",
    "build": "tsc -p src/frontend && vite build --config src/frontend/vite.config.ts",
    "test": "mkdir -p .tmp && rm -f .tmp/wacha-test.db && WACHA_DB_PATH=.tmp/wacha-test.db node --import tsx --test --test-concurrency=1 \"test/**/*.test.ts\"",
    "test2": "mkdir -p .tmp && rm -f .tmp/wacha-test.db && WACHA_DB_PATH=.tmp/wacha-test.db node --import tsx --test --test-concurrency=1 \"test/**/SkillRepository.test.ts\"",
    "grant-role": "tsx scripts/grant-project-role.ts",
    "dev": "npm-run-all --parallel dev:server dev:frontend",
    "dev:server": "tsx watch src/server.ts",
    "dev:frontend": "vite --config src/frontend/vite.config.ts"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "npm-run-all": "^4.1.5",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.2",
    "vite": "^7.1.0"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.12",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@tanstack/react-query": "^5.90.0",
    "better-sqlite3": "^12.8.0",
    "clsx": "^2.1.1",
    "gray-matter": "^4.0.3",
    "hono": "^4.12.9",
    "kysely": "^0.28.15",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.0",
    "tsx": "^4.21.0",
    "zod": "^4.3.6"
  }
}
